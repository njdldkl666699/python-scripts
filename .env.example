AES_KEY=
AES_IV=
# 拦截路径的正则（re.search，匹配含 query string 的完整 path）
# 同时匹配主数据 reload 接口和生日派对 delivery 接口
TARGET_PATH_REGEX=isForceAllReloadOnlyMysekai=True|mysekai/birthday-party/[0-9]+/delivery
# 拦截域名白名单，逗号分隔、自动匹配子域名。
# 设置后仅对这些域名做 MITM 解密，其余域名的 TLS 连接一律直连透传；
# 留空（默认）则不过滤、全部拦截。
INTERCEPT_DOMAINS=
# 是否在启动 mitmproxy 后自动打开浏览器访问前端页面（index.html）
AUTO_OPEN_BROWSER=1